# ---------------------------------------------------------------------------
# PATIENT DATA -- NEVER COMMIT
#
# Everything under data/raw and data/processed may contain identifiable
# patient information (CTC IDs, dates of birth, viral loads). Only the
# synthetic fixture in data/example/ is safe to track.
# ---------------------------------------------------------------------------
# Use dir/* (not dir/) so the .gitkeep negations below can take effect --
# git will not descend into a directory excluded as a whole.
data/raw/*
data/processed/*
output/*
reference/quarto_training.xlsx

# ...but keep the folder placeholders so the structure survives a clone
!data/raw/.gitkeep
!data/processed/.gitkeep
!output/.gitkeep

# macOS
.DS_Store

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site -- NOT excluded here: docs/ holds the SOP and the validation
# protocol, which are controlled documents and must be version controlled.
# This project does not use pkgdown.

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
