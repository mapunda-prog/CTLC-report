# ---------------------------------------------------------------------------
# PATIENT DATA -- NEVER COMMIT
#
# Deny by default: anything under data/ may hold identifiable patient
# information (CTC IDs, dates of birth, viral loads, and the sequences
# themselves). Only data/example/ -- synthetic fixtures and the HXB2-derived
# control panel -- is safe to track.
#
# This is deliberately deny-by-default so that a NEW folder someone creates
# under data/ is ignored automatically rather than being committable until
# someone remembers to add it here.
# ---------------------------------------------------------------------------
data/*
!data/example
!data/raw
!data/processed

# Within the two working folders, keep only the placeholders. Use dir/*
# rather than dir/ so these negations can take effect -- git will not
# descend into a directory excluded as a whole.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

output/*
!output/.gitkeep

# Archived batches -- finished reports and the inputs that produced them.
archive/

reference/quarto_training.xlsx

# macOS
.DS_Store

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site -- NOT excluded here: docs/ holds the SOP and the validation
# protocol, which are controlled documents and must be version controlled.
# This project does not use pkgdown.

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
